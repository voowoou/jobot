# Get these values at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Get the value printed by `pnpm auth`
TELEGRAM_STRING_SESSION=

# Get the token from @BotFather. Send /start to the bot before setup.
TELEGRAM_BOT_TOKEN=

# Run `pnpm bot:setup` to print this value.
TELEGRAM_BOT_CHAT_ID=

# debug | info | warn | error. Logs are emitted as JSON.
LOG_LEVEL=info
